{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rmm",
  "version": "0.1.5",
  "mainBinaryName": "rmm-app",
  "identifier": "dev.rmm.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "rmm",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://staticdelivery.nexusmods.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "rmm",
    "shortDescription": "Rust Mod Manager",
    "longDescription": "A mod manager for Bethesda games: a window, a command line (rmm) and an MCP server.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/ThinhCaoCow/rust-mod-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
