{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rmm",
  "version": "0.1.0",
  "identifier": "dev.rmm.desktop",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "rmm", "width": 1280, "height": 820, "minWidth": 820, "minHeight": 520 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://staticdelivery.nexusmods.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
